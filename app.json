{
  "expo": {
    "name": "Lutra",
    "slug": "lutra",
    "scheme": "lutra",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "description": "Apply LUTs and looks to log videos, in batches, right on your phone.",
    "ios": {
      "icon": "./assets/lutra.icon",
      "supportsTablet": true,
      "bundleIdentifier": "app.lutra.video",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleDevelopmentRegion": "en"
      }
    },
    "android": {
      "package": "app.lutra.video",
      "adaptiveIcon": {
        "backgroundColor": "#6A50EC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Lutra accesses your videos to apply looks and LUTs.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Lutra accesses your library to save exported videos.",
          "savePhotosPermission": "Lutra saves exported videos and frames to your library.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "appGroupId": "group.app.lutra.video",
            "activationRule": {
              "supportsMovieWithMaxCount": 30
            }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "video/*"
            ],
            "multipleShareMimeTypes": [
              "video/*"
            ]
          }
        }
      ],
      "expo-image",
      "expo-video",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 128,
          "resizeMode": "contain",
          "backgroundColor": "#0B0B0C"
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.app.lutra.video",
          "frequentUpdates": true,
          "widgets": [
            {
              "name": "RenderStatus",
              "displayName": "Export",
              "description": "Export progress and a shortcut to a new batch.",
              "supportedFamilies": [
                "accessoryCircular",
                "accessoryRectangular",
                "accessoryInline",
                "systemSmall"
              ]
            },
            {
              "name": "LookOfDay",
              "displayName": "Look of the day",
              "description": "A different look every day, ready to apply.",
              "supportedFamilies": [
                "accessoryRectangular",
                "systemSmall"
              ]
            }
          ]
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "en",
            "pt"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "locales": {
      "en": "./locales/en.json",
      "pt": "./locales/pt.json"
    }
  }
}
